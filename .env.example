# Copia este archivo a .env.local y rellena. .env.local NO se versiona.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=Madison
# Moneda por defecto de tarifas y cargos (ISO 4217)
APP_CURRENCY=EUR
# auditoria (por defecto) | estricto
PERMISOS_MODO=auditoria

# Crons de Vercel (cadena aleatoria larga)
CRON_SECRET=

# Reglas de negocio (vacío o 0 = desactivado; definir con la institución)
# Tasa del trámite Retorno tras un retiro. 0 = el retorno no exige pago.
RETORNO_FEE=0
# Matrícula que paga el prospecto al completar la ficha pública. 0 = sin paso de pago.
MATRICULA_FEE=0
# Enlace y nombre de la pasarela de pago de la matrícula (vacío = sin botón de pago).
PAYMENT_URL=
PAYMENT_PROVIDER=

# Módulos posteriores (dejar vacío por ahora)
RESEND_API_KEY=
RESEND_FROM_EMAIL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
